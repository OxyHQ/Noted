{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noted",
  "version": "0.1.0",
  "identifier": "so.oxy.noted.desktop",
  "build": {
    "frontendDist": "../../packages/frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noted",
        "width": 1100,
        "height": 760,
        "minWidth": 480,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "externalBin": ["binaries/whisper-cli"]
  }
}

{
  "name": "noted-monorepo",
  "version": "1.0.0",
  "description": "Noted — notes app by Oxy",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @noted/frontend dev -- --clear --tunnel",
    "build": "bun run build:frontend",
    "build:types": "bun run --filter @noted/shared-types build",
    "postinstall": "bun run build:types",
    "build:frontend": "bun run build:types && bun run --filter @noted/frontend build",
    "start:frontend": "bun run --filter @noted/frontend start",
    "lint": "biome check .",
    "i18n:check": "oxy-doctor-i18n --ci",
    "typecheck": "bun run --filter @noted/frontend typecheck",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "android": "bun run --filter @noted/frontend android",
    "ios": "bun run --filter @noted/frontend ios",
    "web": "bun run --filter @noted/frontend web",
    "check:android-autolinking": "oxy-doctor-expo-android --project-root=packages/frontend --require-source=SharedDeviceSessionPublish.kt --require-source=SharedDeviceSessionSweep.kt --require-source=OxyDeviceSessionStore.kt",
    "test:worker": "bun test scripts/frontend-worker.test.ts"
  },
  "keywords": [
    "monorepo",
    "notes",
    "expo",
    "noted"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@oxy.so/doctor": "1.7.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "react-native-reanimated": "4.7.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "58.0.2",
    "expo-file-system": "58.0.11",
    "react-native-screens": "4.30.0",
    "react-native-gesture-handler": "3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "expo": "58.0.23",
    "expo-blur": "58.0.5",
    "expo-constants": "58.0.13",
    "expo-font": "58.0.10",
    "expo-image": "58.0.17",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/metro-babel-transformer": "0.88.0",
    "@react-native/metro-config": "0.88.0",
    "@oxy.so/bloom": "17.8.2",
    "@oxy.so/contracts": "6.9.0",
    "@oxy.so/core": "7.23.0",
    "@oxy.so/services": "14.3.8",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/protocol": "1.6.1",
    "react-native-css": "3.1.0-rc.0"
  },
  "dependencies": {
    "@oxy.so/bloom": "17.8.2",
    "@oxy.so/contracts": "6.9.0",
    "@oxy.so/core": "7.23.0",
    "@oxy.so/services": "14.3.8"
  },
  "trustedDependencies": [
    "llama.rn"
  ]
}

{
  "name": "noted-monorepo",
  "version": "1.0.0",
  "description": "Noted — notes app by Oxy",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.20.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter @noted/frontend dev -- --clear --tunnel",
    "build": "bun run build:frontend",
    "build:types": "bun run --filter @noted/shared-types build",
    "build:frontend": "bun run build:types && bun run --filter @noted/frontend build",
    "start:frontend": "bun run --filter @noted/frontend start",
    "lint": "biome check .",
    "typecheck": "bun run --filter @noted/frontend typecheck",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "android": "bun run --filter @noted/frontend android",
    "ios": "bun run --filter @noted/frontend ios",
    "web": "bun run --filter @noted/frontend web",
    "test:worker": "bun test scripts/frontend-worker.test.ts"
  },
  "keywords": [
    "monorepo",
    "notes",
    "expo",
    "noted"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-svg": "15.15.5",
    "react-native-worklets": "0.10.1",
    "react-native-reanimated": "4.5.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo-secure-store": "57.0.4",
    "expo-file-system": "57.0.7",
    "react-native-screens": "4.26.0",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.13",
    "expo": "57.0.28",
    "expo-blur": "57.0.3",
    "expo-constants": "57.0.21",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "@react-native-menu/menu": "2.0.0",
    "@react-native/babel-preset": "0.86.3",
    "@react-native/metro-babel-transformer": "0.86.3",
    "@react-native/metro-config": "0.86.3",
    "@oxy.so/bloom": "10.16.0",
    "@oxy.so/contracts": "4.24.0",
    "@oxy.so/core": "5.2.0",
    "@oxy.so/services": "11.14.0",
    "lightningcss": "1.30.1",
    "lightningcss-linux-x64-gnu": "1.30.1",
    "lightningcss-linux-x64-musl": "1.30.1",
    "@oxy.so/protocol": "1.4.0",
    "react-native-css": "3.1.0-rc.0"
  },
  "dependencies": {
    "@oxy.so/bloom": "10.16.0",
    "@oxy.so/contracts": "4.24.0",
    "@oxy.so/core": "5.2.0",
    "@oxy.so/services": "11.14.0"
  },
  "trustedDependencies": [
    "llama.rn"
  ]
}

# ================================
# DATABASE CONFIGURATION
# ================================
# PostgreSQL connection string.
# Local: start the database with
#   docker compose -f ../../docker-compose.postgres.yml up -d postgres
# then apply the schema with
#   bun run db:migrate --target-database=noted_dev
DATABASE_URL=postgres://noted:noted@127.0.0.1:5438/noted_dev

# Optional pool tuning; the defaults below are what the code uses when unset.
# DATABASE_POOL_MAX=10
# DATABASE_IDLE_TIMEOUT_SECONDS=30
# DATABASE_CONNECT_TIMEOUT_SECONDS=10

# ================================
# API SERVER CONFIGURATION
# ================================
# Port where the API server will run
PORT=3001

# URL of the web application (for CORS)
WEB_URL=http://localhost:3000

# ================================
# OXY PLATFORM IDENTITY AND APP EVENTS
# ================================
# Legacy internal-service bearer used only by existing server-to-server routes.
# Leave unset unless that caller is provisioned; this is not an AI provider key.
SERVICE_SECRET=

# Oxy ApplicationCredential used for catalogue/capability operations and signed
# Noted events. It is a product-service identity, never a user session or AI
# provider key. Inject the secret through the deployment secret store.
OXY_API_URL=https://api.oxy.so
OXY_APPLICATION_KEY=
OXY_APPLICATION_SECRET=
# Event delivery to Alia is an agent-runtime integration, not Noted's inference
# route. Hosted point inference must go Noted -> Oxy -> Kaana instead.
ALIA_API_URL=https://api.alia.onl

# Durable normalized event delivery. Domain writes always enqueue; enabling the
# worker requires the service credentials above and an Alia webhook that accepts
# Oxy service bearer tokens. Leaving it off preserves the backlog.
# NOTED_EVENT_OUTBOX_WORKER_ENABLED=false
# NOTED_EVENT_OUTBOX_POLL_INTERVAL_MS=5000
# NOTED_EVENT_OUTBOX_BATCH_SIZE=50

# Browser origins allowed to call the external MCP resource. Claude and
# ChatGPT are included by default; add exact origins as a comma-separated list.
# Requests without an Origin header still authenticate with a resource-bound
# Oxy OAuth token.
MCP_ALLOWED_ORIGINS=

# ================================
# CHANNEL AUTHENTICATION
# ================================
# Secret shared with the separately deployed Telegram channel bot. Leave unset
# when that integration is not provisioned.
TELEGRAM_BOT_SECRET=

# ================================
# WEB PUSH
# ================================
# Leave all three unset to disable browser push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@noted.oxy.so

# ================================
# REDIS
# ================================
# Optional cache, rate-limit, Socket.IO scaling and reminder scheduling.
# Local: redis://localhost:6379
# Managed: rediss://user:password@host:port
REDIS_URL=
# REDIS_CA_CERT=
# CA_CERT=

LOG_LEVEL=info
NODE_ENV=development

# ================================
# NOTES
# ================================
# - Copy this file to .env and fill in your actual values
# - Never commit .env to version control
# - Never add OpenAI, Anthropic, Google, Groq or any other AI provider key.
#   Hosted provider credentials live only encrypted in Kaana PostgreSQL/KMS.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# Native (CNG — regenerated by expo prebuild)
# Anchored to the project root on purpose. Unanchored, `android/` matches a
# directory of that name at ANY depth — which silently swallows the native
# sources of every local Expo module under `modules/*/android/`, leaving a
# module that autolinks to nothing on a fresh clone.
/android/
/ios/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo


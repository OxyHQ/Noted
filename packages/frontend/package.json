{
  "name": "@noted/frontend",
  "main": "index",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --clear --tunnel",
    "dev": "expo start --scheme noted",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "generate-sitemap": "bun scripts/generate-sitemap.ts",
    "prebuild": "bun run generate-sitemap && bun run copy-ort-runtime",
    "build": "bun x expo export --platform web",
    "build:production": "NODE_ENV=production bun x expo export --platform web --clear",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "test:watch": "vitest",
    "copy-ort-runtime": "bun scripts/copy-ort-runtime.ts"
  },
